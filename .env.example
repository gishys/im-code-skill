# Feishu Codex Orchestrator 环境变量示例
#
# 使用方式：
# 1. 复制本文件为 .env
#      cp .env.example .env
# 2. 按实际环境填写飞书、GitHub、Codex 和项目路径配置
# 3. 本文件不要填写真实密钥后提交到 Git

# -----------------------------------------------------------------------------
# 基础服务配置
# -----------------------------------------------------------------------------

# 运行环境：development | test | production
NODE_ENV=development

# HTTP 服务监听端口。
# 飞书 Webhook 回调、健康检查、任务查询都会走这个端口。
PORT=3005

# HTTP 服务监听地址。
# 0.0.0.0 表示允许容器/局域网/反向代理访问。
# 本机调试也可以改成 127.0.0.1。
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 本地持久化与工作目录
# -----------------------------------------------------------------------------

# SQLite 数据库文件路径。
# 保存任务、任务事件、审批记录、附件记录、部署包记录等。
# 生产环境建议挂载到持久化磁盘，例如 /data/orchestrator.sqlite。
DATABASE_PATH=./data/orchestrator.sqlite

# 项目清单配置文件。
# 里面维护前端/后端仓库地址、默认分支、安装/测试/构建命令、白名单规则。
PROJECTS_CONFIG_PATH=./projects.yaml

# 每个任务的临时工作目录根路径。
# Worker 会在这里按 taskId 创建目录，clone 前后端仓库、保存输入附件和构建产物。
WORKSPACE_ROOT=./workspaces

# 日志目录。
# 建议生产环境持久化，便于排查 Codex、测试、构建、上传等失败原因。
LOG_ROOT=./logs

# -----------------------------------------------------------------------------
# Worker 与 SQLite 队列配置
# -----------------------------------------------------------------------------

# 是否启动内置 worker。
# true：当前进程既提供 HTTP 服务，也执行任务。
# false：当前进程只提供 HTTP 服务，可单独启动 worker 进程。
WORKER_ENABLED=true

# Worker 实例 ID。
# 单机可用 local-worker；多 worker 时应设置不同 ID。
WORKER_ID=local-worker

# Worker 并发数。
# SQLite 首期建议 1 或 2，避免写锁竞争和资源占用过高。
WORKER_CONCURRENCY=1

# 单个任务最大执行时间，单位秒。
# 包含 clone、Codex 修改、测试、构建、打包、PR、飞书上传。
TASK_TIMEOUT_SECONDS=3600

# Worker 心跳间隔，单位秒。
# 用于判断 running 任务是否还活着。
TASK_HEARTBEAT_SECONDS=15

# 任务锁超时时间，单位秒。
# 如果 running 任务超过该时间没有心跳，系统启动或巡检时可标记 interrupted。
TASK_LOCK_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# 飞书接入方式
# -----------------------------------------------------------------------------

# 飞书连接模式：
# polling：本服务主动轮询飞书消息，适合没有公网入口的内网环境。默认推荐。
# webhook：飞书开放平台主动回调本服务，适合有公网 IP/域名或有内网穿透的场景。
FEISHU_CONNECTION_MODE=polling

# 飞书应用 App ID。
# 获取位置：飞书开放平台 -> 应用详情 -> 凭证与基础信息。
FEISHU_APP_ID=

# 飞书应用 App Secret。
# 用于换取 tenant_access_token，调用发消息、上传文件、下载附件等 API。
FEISHU_APP_SECRET=

# 飞书事件订阅 Verification Token。
# 飞书回调时用于校验请求来源，必须与开放平台配置保持一致。
FEISHU_VERIFICATION_TOKEN=

# 飞书事件订阅 Encrypt Key。
# 如果飞书事件订阅开启加密，需要填写该值并实现解密校验。
# 未开启加密时可留空。
FEISHU_ENCRYPT_KEY=

# 当前服务对外可访问的公网基础地址。
# 有公网 IP/域名时示例：
#   FEISHU_PUBLIC_BASE_URL=https://codex-bot.example.com
# 无公网 IP 但使用内网穿透时示例：
#   FEISHU_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# 无公网且使用 polling 模式时可留空。
FEISHU_PUBLIC_BASE_URL=

# polling 模式下需要轮询的飞书 chat_id，多个用英文逗号分隔。
# 可先在 webhook 调试时从事件中获取 chat_id，或通过飞书 API/管理工具查询。
# 示例：
#   FEISHU_POLLING_CHAT_IDS=oc_xxx,oc_yyy
FEISHU_POLLING_CHAT_IDS=

# polling 轮询间隔，单位秒。
# 建议 5-30 秒。越小越实时，但越容易触发 API 频率限制。
FEISHU_POLLING_INTERVAL_SECONDS=10

# 首次启动或没有 offset 时，向前回看多少秒的消息。
# 避免服务启动瞬间漏掉刚刚发送的任务。
FEISHU_POLLING_LOOKBACK_SECONDS=300

# 每个 chat 每次拉取消息数量。
# 飞书接口通常有分页限制，MVP 默认 20，最大 50。
FEISHU_POLLING_PAGE_SIZE=20

# 是否启用飞书进度“流式”更新。
# true：Worker 会持续更新同一张任务卡片，展示当前阶段和日志摘要。
# false：只发送关键节点消息。
FEISHU_PROGRESS_STREAM_ENABLED=true

# 飞书进度卡片最小更新间隔，单位秒。
# 建议 5-10 秒，避免触发飞书 API 频率限制。
FEISHU_PROGRESS_MIN_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# 有公网 IP/域名时的飞书配置方式
# -----------------------------------------------------------------------------
#
# 适用场景：
# - 云服务器、Kubernetes、公司网关等具备公网 HTTPS 入口
# - 使用 Nginx/Caddy/API Gateway 反向代理到本服务
#
# 配置步骤：
# 1. 配置域名和 HTTPS 证书，例如 https://codex-bot.example.com
# 2. 将反向代理转发到 http://127.0.0.1:3005
# 3. 飞书开放平台事件订阅地址填写：
#      https://codex-bot.example.com/feishu/events
# 4. 飞书交互卡片请求地址填写：
#      https://codex-bot.example.com/feishu/actions
# 5. 设置：
#      FEISHU_CONNECTION_MODE=webhook
#      FEISHU_PUBLIC_BASE_URL=https://codex-bot.example.com

# -----------------------------------------------------------------------------
# 无公网 IP 时的飞书配置方式
# -----------------------------------------------------------------------------
#
# 方案 A：内网穿透，推荐本地开发和小团队测试
# - 可使用 Cloudflare Tunnel、frp、ngrok 等工具生成 HTTPS 地址
# - 飞书事件订阅地址填写：
#      https://your-tunnel-domain/feishu/events
# - 飞书交互卡片请求地址填写：
#      https://your-tunnel-domain/feishu/actions
# - 设置：
#      FEISHU_CONNECTION_MODE=webhook
#      FEISHU_PUBLIC_BASE_URL=https://your-tunnel-domain
#
# 方案 B：主动轮询，推荐完全不能开放入站连接的内网环境，也是本项目默认模式
# - 服务定时调用飞书 API 拉取 FEISHU_POLLING_CHAT_IDS 中指定会话的新消息
# - 用户通过文本命令确认/取消/查看任务：
#      确认执行：task-xxx
#      取消任务：task-xxx
#      查看状态：task-xxx
# - 设置：
#      FEISHU_CONNECTION_MODE=polling
#      FEISHU_PUBLIC_BASE_URL=
#      FEISHU_POLLING_CHAT_IDS=oc_xxx
#
# 方案 C：飞书多维表格/审批作为任务入口
# - 用户在表格或审批中提交任务
# - 服务轮询新增记录并创建任务
# - 适合审计要求更强的企业流程

# -----------------------------------------------------------------------------
# GitHub 配置
# -----------------------------------------------------------------------------

# GitHub Token。
# 用于创建 PR、查询仓库信息等。
# 推荐使用 GitHub App；MVP 可使用 fine-grained personal access token。
# 所需权限通常包括目标仓库 Contents 读写、Pull requests 读写。
GITHUB_TOKEN=

# GitHub owner 或 organization。
# 例如仓库是 github.com/acme/demo-frontend，则填写 acme。
GITHUB_OWNER=

# -----------------------------------------------------------------------------
# Codex 配置
# -----------------------------------------------------------------------------

# Codex CLI 命令。
# 如果 codex 已在 PATH 中，保持 codex 即可。
# 如果使用固定路径，可填写完整路径。
CODEX_COMMAND=codex

# Codex 单次执行超时时间，单位秒。
# 如果需求复杂或仓库较大，可适当提高。
CODEX_TIMEOUT_SECONDS=1800
